	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_NAZO,        BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       18, BALLOON_FRAME_TYPE_BUC,            "That's right. Astrid...<CR>The owner isn't here, is she?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       19, BALLOON_FRAME_TYPE_BUC,            "Yes.<CR>I don't know where she went, but..." },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_NAZO,        BUC_STERK_KANA,     BUC_POSITION_TYPE_R,       20, BALLOON_FRAME_TYPE_BUC,            "I see...then I have no choice.<CR>Please give her this message" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       21, BALLOON_FRAME_TYPE_BUC,            "Oh, wait a moment please.<CR>Let me get something to write with...okay, ready!" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_NAZO,        BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       22, BALLOON_FRAME_TYPE_BUC,            "By order of the Minister and the King,<CR>the shop permit for this Atelier<CR>will be revoked" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       23, BALLOON_FRAME_TYPE_BUC,            "The shop permit will be revoked...<CR>EEEEEEEH?!" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_NAZO,        BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       24, BALLOON_FRAME_TYPE_BUC,            "For details, she must speak directly.<CR>Tell her to come to the castle when she returns.<CR>Now if you'll excuse me" },
