	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       13, BALLOON_FRAME_TYPE_BUC,            "Right, when I'm like this, I should take deep breaths!<CR>Breath in, breath out, breath in, haaaa..." },
