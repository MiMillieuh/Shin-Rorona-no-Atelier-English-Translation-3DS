	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L,        2, BALLOON_FRAME_TYPE_BUC,            "...Yeah, that's definitely not going to happen...<CR>Sighhhhh..." },
	{ BALLOON_MODE_BUCSYS, CHARA_CUDERIA,    0, NAME_NAZO,        BUC_NONE,           BUC_POSITION_TYPE_NONE,     3, BALLOON_FRAME_TYPE_BUC,            "What's with that long face?!" },
