BalloonData MA01_060_EMS[] = {
	// ▼アトリエに戻ってくる主人公
	// ▼なにやら作業している師匠
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,        0, BALLOON_FRAME_TYPE_BUC,            "I'm back.<CR>Oh, wow! Master is actually here!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,        1, BALLOON_FRAME_TYPE_BUC,            "Greeting me with 'wow,' are we?<CR>Oh my, and the young lady from the Feuerbach family is with you" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_L2,       2, BALLOON_FRAME_TYPE_BUC,            "I've told you to stop with that sarcastic way of addressing me!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,        3, BALLOON_FRAME_TYPE_BUC,            "I see. Then I'll have you call me Kuu-chan as well" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_L2,       4, BALLOON_FRAME_TYPE_BUC,            "Stop it!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R,        5, BALLOON_FRAME_TYPE_BUC,            "This is no good, that's no good...oh dear.<CR>Young ladies certainly have their hands full with their whims" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_L2,       6, BALLOON_FRAME_TYPE_BUC,            "Grrr! Wh-who's whiny?! Who's the whiny one?!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,        7, BALLOON_FRAME_TYPE_BUC,            "Please don't fight...<CR>B-but Master!<CR>I went to the castle and heard what you told me" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,        8, BALLOON_FRAME_TYPE_BUC,            "Yes, I was waiting to hear about it.<CR>Kuu-chan made me get sidetracked<CR>from the conversation" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_L2,       9, BALLOON_FRAME_TYPE_BUC,            "Don't blame me!<CR>And stop calling me Kuu-chan!" },
	// ▼また説明に入って…
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R,       10, BALLOON_FRAME_TYPE_BUC,            "...I see, I understand.<CR>I had a feeling they wouldn't just shut us down abruptly,<CR>but this is mostly as I expected" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_L2,      11, BALLOON_FRAME_TYPE_BUC,            "What's with that smug face?<CR>This isn't funny at all" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_L2,      12, BALLOON_FRAME_TYPE_BUC,            "The Atelier's going to be shut down—<CR>you're going to be kicked out of the country—<CR>wouldn't you panic a little?!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,       13, BALLOON_FRAME_TYPE_BUC,            "Panicking won't solve anything.<CR>Speaking of which, haven't you been quite calm yourself, young lady?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_L2,      14, BALLOON_FRAME_TYPE_BUC,            "Why would I be the one panicking?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R,       15, BALLOON_FRAME_TYPE_BUC,            "Ah, Rorona does have cold friends, doesn't she?<CR>If the Atelier closes, Rorona would have to leave town,<CR>and yet here you are" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       16, BALLOON_FRAME_TYPE_BUC,            "Huh? W-would I have to leave too?!" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_L2,      17, BALLOON_FRAME_TYPE_BUC,            "Wh-why should I be the one?!<CR>You should leave by yourself!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       18, BALLOON_FRAME_TYPE_BUC,            "Why, you ask? Rorona owes me a debt, you know.<CR>I can't just let her go until<CR>she's paid it back" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "Or perhaps you thought I would be<CR>so kind as to forgive Rorona's debt<CR>on this occasion?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_L2,      20, BALLOON_FRAME_TYPE_BUC,            "Tch...right.<CR>I forgot that you're a thoroughly rotten,<CR>despicable human being..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       21, BALLOON_FRAME_TYPE_BUC,            "I'll take that as a compliment" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_AKI,    BUC_POSITION_TYPE_L2,      22, BALLOON_FRAME_TYPE_BUC,            "But! Even you won't be able to keep slacking off<CR>like you always have, you know?<CR>Hmph, serves you right" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       23, BALLOON_FRAME_TYPE_BUC,            "As long as Master works hard, we'll be fine, right?<CR>She can do it if she puts her mind to it!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       24, BALLOON_FRAME_TYPE_BUC,            "That's true. If I put my mind to something,<CR>I can accomplish most anything" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       25, BALLOON_FRAME_TYPE_BUC,            "See? Great...<CR>Oh, by the way, what have you been working on this whole time?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "Ah, this is a new signboard for the Atelier.<CR>I thought we'd make a fresh start,<CR>so I decided to start with the appearance first" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_ODO,    BUC_POSITION_TYPE_L2,      27, BALLOON_FRAME_TYPE_BUC,            "What?<CR>You're actually serious about this?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       28, BALLOON_FRAME_TYPE_BUC,            "Alright, it's done.<CR>Time to put it up" },
