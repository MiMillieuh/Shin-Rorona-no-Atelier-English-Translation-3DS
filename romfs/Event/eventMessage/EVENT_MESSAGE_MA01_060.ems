	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    29, BALLOON_FRAME_TYPE_BUC,            "What do you think? Not bad, right?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    30, BALLOON_FRAME_TYPE_BUC,            "Wow, what a cute sign.<CR>Hmm, 'Rorona's Atelier'?<CR>So the name changed too..." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    31, BALLOON_FRAME_TYPE_BUC,            "Wait, EEEEEEEEH?!" },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    32, BALLOON_FRAME_TYPE_BUC,            "Starting today, this Atelier belongs to you.<CR>I'll leave it in your hands" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    33, BALLOON_FRAME_TYPE_BUC,            "In my hands?! No way!<CR>Absolutely impossible!" },
	{ BALLOON_MODE_BUCSYS, CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_NONE,           BUC_POSITION_TYPE_NONE,    34, BALLOON_FRAME_TYPE_BUC,            "That's right! There's no way!<CR>Like a goody-two-shoes, scatterbrained, airheaded,<CR>clueless girl could run an Atelier!" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    35, BALLOON_FRAME_TYPE_BUC,            "Hey, you didn't have to say all that..." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    36, BALLOON_FRAME_TYPE_BUC,            "B-but this is really impossible!<CR>I can't do alchemy at all, you know?<CR>Master never taught me anything!" },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    37, BALLOON_FRAME_TYPE_BUC,            "I've taken care of that part.<CR>Here, do this" },
	// ▼一番初歩的な錬金術の本（レシピ）をもらう
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       38, BALLOON_FRAME_TYPE_BUC,            "Huh? What's this book?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,       39, BALLOON_FRAME_TYPE_BUC,            "It's a book about the basics of alchemy.<CR>This was the first thing I received<CR>when I became the previous owner's apprentice" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       40, BALLOON_FRAME_TYPE_BUC,            "Huh? Aren't you giving away something really important?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       41, BALLOON_FRAME_TYPE_BUC,            "Of course. You're my first disciple, aren't you?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       42, BALLOON_FRAME_TYPE_BUC,            "Master...thank you so much!<CR>I'll do my best!" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_L2,      43, BALLOON_FRAME_TYPE_BUC,            "Doing your best?!<CR>Don't let yourself be swayed so easily!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_WARA,    BUC_POSITION_TYPE_R,       44, BALLOON_FRAME_TYPE_BUC,            "Ah, one job tires me out so much.<CR>A nap is the perfect remedy for times like these, yes" },
