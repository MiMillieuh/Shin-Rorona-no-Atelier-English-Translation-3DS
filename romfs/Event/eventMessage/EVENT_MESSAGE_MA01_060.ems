	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_L2,      45, BALLOON_FRAME_TYPE_BUC,            "Hey, wait! You can't just—<CR>And stop reading that book so happily!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       46, BALLOON_FRAME_TYPE_BUC,            "Huh? Oh no!<CR>Wait for me, Master!" },
