	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_ODO,   BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "What...? You wouldn't happen to have gone easy on them, would you?" },
