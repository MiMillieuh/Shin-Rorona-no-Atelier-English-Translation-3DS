	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_IKA,   BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "Gah... Very well. You did well this time, but you'll surely slip up sooner or later" },
