	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_IKA,   BUC_POSITION_TYPE_R,       10, BALLOON_FRAME_TYPE_BUC,            "Tch, how annoying. Those Atelier brats" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_IKA,   BUC_POSITION_TYPE_R,       11, BALLOON_FRAME_TYPE_BUC,            "If the King hadn't gone and said he would give them more time, I would have shut down that Atelier long ago" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_IKA,   BUC_POSITION_TYPE_R,       12, BALLOON_FRAME_TYPE_BUC,            "Honestly! You little girls are always running around playing, but when it actually matters, you submit your reports..." },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_L,       13, BALLOON_FRAME_TYPE_BUC,            "Even for a minister, I cannot overlook such insults against the King" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_NOR,   BUC_POSITION_TYPE_R,       14, BALLOON_FRAME_TYPE_BUC,            "Hmph, you clearly don't understand. Neither you nor the King does" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_NOR,   BUC_POSITION_TYPE_R,       15, BALLOON_FRAME_TYPE_BUC,            "If we converted the entire region where the Atelier stands into factory land and built a mass production system, just think of how much it would benefit the country..." },
