	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L,       12, BALLOON_FRAME_TYPE_BUC,            "Don't be so impatient.<CR>Now then... let's start with you" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_R,       13, BALLOON_FRAME_TYPE_BUC,            "Me? Wait, what are you doing with your hands?<CR>N-no! Don't come closer!" },
