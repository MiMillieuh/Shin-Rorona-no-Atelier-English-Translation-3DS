BalloonData MZ01_140_EMS[] = {
	// ▼Rorona returns to the atelier with great enthusiasm
	{ BALLOON_MODE_CHASYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,     0, BALLOON_FRAME_TYPE_NORMAL,         "Master! Master--!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,        1, BALLOON_FRAME_TYPE_BUC,            "I passed! I passed!<CR>I can keep running the atelier!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,       2, BALLOON_FRAME_TYPE_BUC,            "Oh, I see.<CR>Well, I expected you would pass" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,        3, BALLOON_FRAME_TYPE_BUC,            "...Isn't the reaction a little underwhelming?<CR>I worked really hard, you know. Three whole years..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,       4, BALLOON_FRAME_TYPE_BUC,            "I know that better than anyone.<CR>You did well. Congratulations" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_TERE,    BUC_POSITION_TYPE_L,        5, BALLOON_FRAME_TYPE_BUC,            "...Ehehe, thank you" },
	{ BALLOON_MODE_CHARA,  CHARA_HOM_M,      0, NAME_HOM_M,       BUC_NONE,           BUC_POSITION_TYPE_NONE,     6, BALLOON_FRAME_TYPE_NORMAL,         "Grand Master. Preparations are complete" },
	{ BALLOON_MODE_CHARA,  CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,     7, BALLOON_FRAME_TYPE_NORMAL,         "Ah, good work" },
	{ BALLOON_MODE_CHARA,  CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,     8, BALLOON_FRAME_TYPE_NORMAL,         "What are you doing, Hom-chan?<CR>That sure is a big luggage to pack" },
	// ★Hom BUC clear
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,       9, BALLOON_FRAME_TYPE_BUC,            "I asked Hom to do that.<CR>I plan to leave town now" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       10, BALLOON_FRAME_TYPE_BUC,            "Leave? Now?<CR>I was planning to celebrate today too...<CR>How long will you be gone?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      11, BALLOON_FRAME_TYPE_BUC,            "Not leaving temporarily. I said I'm leaving.<CR>I don't intend to come back for a while" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       12, BALLOON_FRAME_TYPE_BUC,            "Ha...? You don't intend to come back?<CR>Eh? Wh-what are you saying?<CR>That's so sudden... eh?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      13, BALLOON_FRAME_TYPE_BUC,            "It's not sudden. I decided this a long time ago.<CR>In the end, I just kept putting it off until today" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       14, BALLOON_FRAME_TYPE_BUC,            "You're... you're serious...?<CR>Eh? Wh-why?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L,       15, BALLOON_FRAME_TYPE_BUC,            "I just passed my exam,<CR>and the atelier is safe... there's<CR>no reason for you to leave!!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      16, BALLOON_FRAME_TYPE_BUC,            "You passed the exam, not me" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      17, BALLOON_FRAME_TYPE_BUC,            "And this is your atelier now.<CR>I have no reason to stay here" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       18, BALLOON_FRAME_TYPE_BUC,            "Th-that's not true!<CR>Because you're my master,<CR>and this atelier is... so..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      19, BALLOON_FRAME_TYPE_BUC,            "I'm sorry.<CR>Not being able to say things except in a roundabout way<CR>is a bad habit of mine" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      20, BALLOON_FRAME_TYPE_BUC,            "...Do you remember<CR>the story I told you about my master?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX1,     BUC_POSITION_TYPE_L,       21, BALLOON_FRAME_TYPE_BUC,            "The story about your master can wait for now..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      22, BALLOON_FRAME_TYPE_BUC,            "Just listen to me" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      23, BALLOON_FRAME_TYPE_BUC,            "As I told you before,<CR>my master lacked skill as an alchemist" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      24, BALLOON_FRAME_TYPE_BUC,            "For that reason alone, they received<CR>a lot of cold treatment from the castle folk..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX1,     BUC_POSITION_TYPE_L,       -1, BALLOON_FRAME_TYPE_BUC,            "………." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      26, BALLOON_FRAME_TYPE_BUC,            "At that time, I was already doing<CR>most of the work from the townspeople...<CR>But I suppose that caused problems too" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      27, BALLOON_FRAME_TYPE_BUC,            "Not just from the castle folk, but from the townspeople too,<CR>my master became someone distant. Even from me" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       28, BALLOON_FRAME_TYPE_BUC,            "That's..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_IKA,     BUC_POSITION_TYPE_R2,      29, BALLOON_FRAME_TYPE_BUC,            "When my master fell ill,<CR>only a handful of people came to visit them" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_IKA,     BUC_POSITION_TYPE_R2,      30, BALLOON_FRAME_TYPE_BUC,            "And so, I came to refuse using alchemy<CR>for the people of this town.<CR>...After my master passed away" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       -1, BALLOON_FRAME_TYPE_BUC,            "………." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      32, BALLOON_FRAME_TYPE_BUC,            "If you call it bearing a grudge, so be it,<CR>and if you say I was just being stubborn,<CR>I won't deny it" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      33, BALLOON_FRAME_TYPE_BUC,            "Even so, I..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NAKI,    BUC_POSITION_TYPE_L,       34, BALLOON_FRAME_TYPE_BUC,            "Th-then!<CR>Are you leaving because you<CR>hate the people of this town!?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_ODO,     BUC_POSITION_TYPE_R2,      35, BALLOON_FRAME_TYPE_BUC,            "That's not it. I..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      36, BALLOON_FRAME_TYPE_BUC,            "Aah, I really don't want to say this..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L,       37, BALLOON_FRAME_TYPE_BUC,            "Please tell me!<CR>Otherwise, I won't be satisfied!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_R2,      38, BALLOON_FRAME_TYPE_BUC,            "Muu. So you see, the thing is..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_R2,      39, BALLOON_FRAME_TYPE_BUC,            "I wanted to try doing things seriously again too,<CR>using alchemy for the people..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_R2,      40, BALLOON_FRAME_TYPE_BUC,            "Watching you made me feel that way" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       41, BALLOON_FRAME_TYPE_BUC,            "...Eh?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_IKA,     BUC_POSITION_TYPE_R2,      42, BALLOON_FRAME_TYPE_BUC,            "What's with that face?<CR>Hmph, you're probably thinking I'm just saying<CR>something that doesn't suit me, aren't you" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_IKA,     BUC_POSITION_TYPE_R2,      43, BALLOON_FRAME_TYPE_BUC,            "I know that better than anyone without you having to tell me!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       44, BALLOON_FRAME_TYPE_BUC,            "Th-that's not it!<CR>It's just, it was so unexpected..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L,       45, BALLOON_FRAME_TYPE_BUC,            "But if that's the case,<CR>you don't have to go to another town" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L,       46, BALLOON_FRAME_TYPE_BUC,            "You could just do it<CR>here, with me!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      47, BALLOON_FRAME_TYPE_BUC,            "Starting from a deficit is<CR>more troublesome than starting from zero" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      48, BALLOON_FRAME_TYPE_BUC,            "I'm not skilled enough to suddenly start<CR>being nice to familiar faces again,<CR>and more than anything..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      49, BALLOON_FRAME_TYPE_BUC,            "The relationships you've built with the townspeople<CR>might be destroyed because of me.<CR>That's the one thing I can't accept" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX1,     BUC_POSITION_TYPE_L,       50, BALLOON_FRAME_TYPE_BUC,            "But, but..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      51, BALLOON_FRAME_TYPE_BUC,            "Ah, don't cry, don't cry.<CR>You haven't grown at all in that regard..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      52, BALLOON_FRAME_TYPE_BUC,            "It's not like we'll never see each other again,<CR>so when I've settled down,<CR>I'll come visit at least" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       53, BALLOON_FRAME_TYPE_BUC,            "You... you promise...?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R2,      54, BALLOON_FRAME_TYPE_BUC,            "It's the truth. I'd be lonely too<CR>if I couldn't see your face anymore, you know" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      55, BALLOON_FRAME_TYPE_BUC,            "Besides, you'd probably slack off immediately<CR>if I wasn't watching you" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       56, BALLOON_FRAME_TYPE_BUC,            "...That's rich coming from you" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      57, BALLOON_FRAME_TYPE_BUC,            "You finally smiled.<CR>Yes, being seen off with a smile<CR>feels much better" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      58, BALLOON_FRAME_TYPE_BUC,            "Well then... let's go" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       59, BALLOON_FRAME_TYPE_BUC,            "Ah..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R2,      60, BALLOON_FRAME_TYPE_BUC,            "Hom, I'm leaving Rorona in your care" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_KANA,     BUC_POSITION_TYPE_L2,      61, BALLOON_FRAME_TYPE_BUC,            "Understood. Please take care and have a safe trip" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      62, BALLOON_FRAME_TYPE_BUC,            "Goodbye, Rorona" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       63, BALLOON_FRAME_TYPE_BUC,            "Yes, um... take care" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_WARA,    BUC_POSITION_TYPE_R2,      64, BALLOON_FRAME_TYPE_BUC,            "Yes. I'll be back" },
	// ▼Master leaving the atelier
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       65, BALLOON_FRAME_TYPE_BUC,            "...They're gone" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_KANA,     BUC_POSITION_TYPE_L2,      66, BALLOON_FRAME_TYPE_BUC,            "Yes. They're gone" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       67, BALLOON_FRAME_TYPE_BUC,            "The master will surely become<CR>a famous alchemist in no time, right?" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_L2,      68, BALLOON_FRAME_TYPE_BUC,            "Hom thinks so too.<CR>The Grand Master is a genius, after all" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       69, BALLOON_FRAME_TYPE_BUC,            "Right,<CR>there's no way I could compare..." },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_IKA,      BUC_POSITION_TYPE_L2,      70, BALLOON_FRAME_TYPE_BUC,            "I cannot agree with that.<CR>Hom believes that Master is a splendid master too" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       71, BALLOON_FRAME_TYPE_BUC,            "...Thanks, Hom-chan" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       72, BALLOON_FRAME_TYPE_BUC,            "Alright, I need to work even harder,<CR>much much more!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       73, BALLOON_FRAME_TYPE_BUC,            "If I let my guard down,<CR>the master will overtake me before I know it" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_HOHO,     BUC_POSITION_TYPE_L2,      74, BALLOON_FRAME_TYPE_BUC,            "Hom will help too.<CR>Please give me any order, Master" },
	// ▼Two of them trying to start work
