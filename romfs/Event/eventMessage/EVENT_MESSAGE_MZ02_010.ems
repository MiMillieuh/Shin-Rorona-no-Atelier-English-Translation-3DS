	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R,       16, BALLOON_FRAME_TYPE_BUC,            "Welcome is not what you say!<CR>Didn't you say we were going out together today?<CR>Did you forget!?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L2,      17, BALLOON_FRAME_TYPE_BUC,            "Huh...? Oh, ahhhh!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L2,      18, BALLOON_FRAME_TYPE_BUC,            "Um, well... ahahaha..." },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "Don't try to laugh it off!<CR>Honestly, taking on way too much work<CR>when you can't even handle it..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L2,      20, BALLOON_FRAME_TYPE_BUC,            "Th-that's not true!<CR>I can definitely do it!" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_L,       21, BALLOON_FRAME_TYPE_BUC,            "I would not say \"can't do it.\"<CR>That is, if we ignore the condition<CR>of meeting deadlines" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L2,      22, BALLOON_FRAME_TYPE_BUC,            "...Hom-chan, that's not helping" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,       23, BALLOON_FRAME_TYPE_BUC,            "...Fine. I understand.<CR>If that's how it is, then I have a plan" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L2,      24, BALLOON_FRAME_TYPE_BUC,            "A plan?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R,       25, BALLOON_FRAME_TYPE_BUC,            "From this moment,<CR>I'll be taking charge of this atelier!<CR>You have no objections, I assume?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L2,      26, BALLOON_FRAME_TYPE_BUC,            "Eh? Eh... ehhhhhhh!?" },
