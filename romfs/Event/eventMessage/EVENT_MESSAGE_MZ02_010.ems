BalloonData MZ02_010_EMS[] = {
	// ▼Cordelia waiting somewhere in town, irritated and waiting for Rorona
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_L,        0, BALLOON_FRAME_TYPE_BUC,            "...You're late!<CR>The meeting time was long past!<CR>Don't tell me, again..." },
