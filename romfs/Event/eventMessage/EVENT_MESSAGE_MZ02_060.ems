	// ▼Black screen clears, late at night. Everyone exhausted
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L2,      17, BALLOON_FRAME_TYPE_BUC,            "Finally done--... I can't move anymore..." },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_L,       18, BALLOON_FRAME_TYPE_BUC,            "Thank you for your hard work.<CR>Hom will get some drinks" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_KANA,       BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "Ah, that helps.<CR>But if it's like this every day,<CR>your body won't hold up, will it?" },
	// ★Hom BUC clear
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L2,      20, BALLOON_FRAME_TYPE_BUC,            "Yeah... if Gio-san hadn't come today,<CR>it could've been really dangerous today..." },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_NOR,        BUC_POSITION_TYPE_R,       21, BALLOON_FRAME_TYPE_BUC,            "Being passionate about work is fine,<CR>but why don't you consider reducing your workload a bit?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L2,      22, BALLOON_FRAME_TYPE_BUC,            "But there's my promise to the master..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L2,      23, BALLOON_FRAME_TYPE_BUC,            "And everyone is having trouble,<CR>so they come to me,<CR>but if I start refusing..." },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_HOHO,       BUC_POSITION_TYPE_R,       24, BALLOON_FRAME_TYPE_BUC,            "Good grief. You're too nice, or rather..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L2,      25, BALLOON_FRAME_TYPE_BUC,            "S-sorry..." },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_NOR,        BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "No, I'm not blaming you.<CR>However, realistically speaking,<CR>you can't keep this up, can you?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L2,      27, BALLOON_FRAME_TYPE_BUC,            "Yes... I wonder if there's a good solution..." },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_HOHO,       BUC_POSITION_TYPE_R,       28, BALLOON_FRAME_TYPE_BUC,            "Hmm... how about something like this?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L2,      29, BALLOON_FRAME_TYPE_BUC,            "Eh?" },
	// ▼Black fade with time skip
	// ▼First conversation on the black screen
	// ▼Sound of Sterk running up
	{ BALLOON_MODE_BUCSYS, CHARA_STERK,      0, NAME_STERK,       BUC_NONE,           BUC_POSITION_TYPE_NONE,    30, BALLOON_FRAME_TYPE_BUC_SHOUT,      "Hey!" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    31, BALLOON_FRAME_TYPE_BUC,            "Whoa, what's wrong, Sterk-san?" },
	{ BALLOON_MODE_BUCSYS, CHARA_STERK,      0, NAME_STERK,       BUC_NONE,           BUC_POSITION_TYPE_NONE,    32, BALLOON_FRAME_TYPE_BUC,            "The King has escaped again!<CR>He's not here, is he!?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    33, BALLOON_FRAME_TYPE_BUC,            "Ah, um... I haven't seen him today..." },
	{ BALLOON_MODE_BUCSYS, CHARA_STERK,      0, NAME_STERK,       BUC_NONE,           BUC_POSITION_TYPE_NONE,    34, BALLOON_FRAME_TYPE_BUC,            "I see, sorry for the disturbance.<CR>Dang it, where could he be!" },
	// ▼Sound of him running away
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    35, BALLOON_FRAME_TYPE_BUC,            "...Whew, did I manage to escape his notice?" },
	// ▼Illustration display
