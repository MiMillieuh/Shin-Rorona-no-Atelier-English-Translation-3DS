	{ BALLOON_MODE_CHASYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,     3, BALLOON_FRAME_TYPE_NORMAL,         "Still going strong, I see.<CR>At this rate, the two inside..." },
