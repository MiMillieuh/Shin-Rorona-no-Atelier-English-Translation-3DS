BalloonData MZ02_060_EMS[] = {
	// ▼In front of the castle. Gio sneaking out
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_NOR,        BUC_POSITION_TYPE_L,        0, BALLOON_FRAME_TYPE_BUC,            "Whew. Managed to not get caught, I see" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_KANA,       BUC_POSITION_TYPE_L,        1, BALLOON_FRAME_TYPE_BUC,            "Honestly, Sterk.<CR>There's no need to be so strict with surveillance<CR>and all" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_HOHO,       BUC_POSITION_TYPE_L,        2, BALLOON_FRAME_TYPE_BUC,            "Well then. For now, I'll just<CR>hide myself over there again" },
	// ▼Gio walking through town, scene change, all the way to the front of the atelier
