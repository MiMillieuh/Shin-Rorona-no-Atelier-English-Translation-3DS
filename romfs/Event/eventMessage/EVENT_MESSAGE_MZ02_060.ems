	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    36, BALLOON_FRAME_TYPE_BUC,            "Good grief... what are you running away from today?" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    37, BALLOON_FRAME_TYPE_BUC,            "Ah, listen to this.<CR>It's a terrible story" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    38, BALLOON_FRAME_TYPE_BUC,            "While I was away from the castle,<CR>arrangements for a marriage meeting<CR>were being made without my knowledge" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    39, BALLOON_FRAME_TYPE_BUC,            "A marriage meeting?<CR>But well, Gio-san, you're at that age..." },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    40, BALLOON_FRAME_TYPE_BUC,            "Are you on their side too?<CR>Please, have mercy" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    41, BALLOON_FRAME_TYPE_BUC,            "On this matter, even Sterk and Meriodas<CR>are working together.<CR>If I have you as an enemy too..." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    42, BALLOON_FRAME_TYPE_BUC,            "Please come out of the cauldron first.<CR>I can't get any work done" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    43, BALLOON_FRAME_TYPE_BUC,            "Ah, sorry.<CR>I just couldn't resist, it's such a good hiding spot" },
	{ BALLOON_MODE_SYSTEM, CHARA_NONE,       0, NAME_NONE,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    -1, BALLOON_FRAME_TYPE_NORMAL,         "And so, Rorona responded to the King's summons and became an alchemist attached to the royal court" },
	{ BALLOON_MODE_SYSTEM, CHARA_NONE,       0, NAME_NONE,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    -1, BALLOON_FRAME_TYPE_NORMAL,         "The advanced alchemy skills she developed through three years of work would later contribute greatly to the kingdom's development, but" },
	{ BALLOON_MODE_SYSTEM, CHARA_NONE,       0, NAME_NONE,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    -1, BALLOON_FRAME_TYPE_NORMAL,         "...that's a story for a little further down the line" },
	{ BALLOON_MODE_SYSTEM, CHARA_NONE,       0, NAME_NONE,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    -1, BALLOON_FRAME_TYPE_NORMAL,         "For now, it seems she'll be spending more time listening to the King talk than doing alchemy work" },
	// ▼After text ends
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    48, BALLOON_FRAME_TYPE_BUC,            "Well then, until things cool down,<CR>I might as well go swing a sword outside of town.<CR>How about it, come with me?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    49, BALLOON_FRAME_TYPE_BUC,            "I still have work to...<CR>Hmm, but maybe just this once" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    50, BALLOON_FRAME_TYPE_BUC,            "Alright. Let's get going before we're found" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    51, BALLOON_FRAME_TYPE_BUC,            "...Ah, right.<CR>If I just go ahead and marry someone close to me,<CR>people will stop being so pushy" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    52, BALLOON_FRAME_TYPE_BUC,            "Eh? Gio-san, is there someone like that?" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    53, BALLOON_FRAME_TYPE_BUC,            "Hmm, well.<CR>I'd need to confirm the other person's feelings first, though" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    54, BALLOON_FRAME_TYPE_BUC,            "Ooh! Let me know when you find out!" },
	{ BALLOON_MODE_BUCSYS, CHARA_GIO,        0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    55, BALLOON_FRAME_TYPE_BUC,            "Ah... the prospects look dim, though..." },
