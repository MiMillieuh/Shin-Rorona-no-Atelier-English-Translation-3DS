	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_R,        6, BALLOON_FRAME_TYPE_BUC,            "Three more" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NAKI,    BUC_POSITION_TYPE_L2,       7, BALLOON_FRAME_TYPE_BUC,            "Three!?<CR>Waaah! What do I do, what do I do!<CR>There's no way I'll finish!" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R2,       8, BALLOON_FRAME_TYPE_BUC,            "It's because you take on any and all work<CR>without thinking!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L2,       9, BALLOON_FRAME_TYPE_BUC,            "But...<CR>everyone comes with such worried faces..." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_HOHO,   BUC_POSITION_TYPE_L,       10, BALLOON_FRAME_TYPE_BUC,            "She couldn't say no.<CR>Rorona-chan is so kind..." },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R2,      11, BALLOON_FRAME_TYPE_BUC,            "It's not about being kind or not!<CR>Because of this, both you and I<CR>are being made to help, aren't you!!" },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_KANA,   BUC_POSITION_TYPE_L,       12, BALLOON_FRAME_TYPE_BUC,            "Ouch. Y-you don't have to yell like that..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L2,      13, BALLOON_FRAME_TYPE_BUC,            "Uuu, sorry you two.<CR>Even though you came to play..." },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R2,      14, BALLOON_FRAME_TYPE_BUC,            "If you have time to apologize, then move your hands! Come on!" },
