	// ▼
	{ BALLOON_MODE_SYSTEM, CHARA_NONE,       0, NAME_NONE,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    -1, BALLOON_FRAME_TYPE_NORMAL,         "And so, a year passed--" },
	// ▼
	// ▼Rorona and Hom looking idle at the atelier
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L2,      47, BALLOON_FRAME_TYPE_BUC,            "...We're so idle, Hom-chan" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_KANA,     BUC_POSITION_TYPE_R,       48, BALLOON_FRAME_TYPE_BUC,            "Yes, Hom wants to work" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L2,      49, BALLOON_FRAME_TYPE_BUC,            "We were so busy until last week...<CR>I wonder why?" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_R,       50, BALLOON_FRAME_TYPE_BUC,            "I sincerely apologize, but Hom does not know" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L2,      51, BALLOON_FRAME_TYPE_BUC,            "Hmm... could it be,<CR>did I make some mistake?<CR>Could that be why everyone's angry..." },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_R,       52, BALLOON_FRAME_TYPE_BUC,            "That is impossible.<CR>Master's work was perfect" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_TERE,    BUC_POSITION_TYPE_L2,      53, BALLOON_FRAME_TYPE_BUC,            "R-really? But then, why..." },
	{ BALLOON_MODE_BUCSYS, CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_NONE,           BUC_POSITION_TYPE_NONE,    54, BALLOON_FRAME_TYPE_BUC,            "Rorona! It's an emergency!" },
	// ▼Cordelia rushes into the atelier
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L2,      55, BALLOON_FRAME_TYPE_BUC,            "Kuu-chan? What's wrong, running like that?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,       56, BALLOON_FRAME_TYPE_BUC,            "Just come already! Hurry!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L2,      57, BALLOON_FRAME_TYPE_BUC,            "Whoa, don't pull me--!" },
	// ▼Scene change, somewhere in town. A huge line has formed
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       58, BALLOON_FRAME_TYPE_BUC,            "Whoa, what a long line. What's going on?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R,       59, BALLOON_FRAME_TYPE_BUC,            "You can't be so carefree...<CR>These are all customers from your shop!<CR>They've all been stolen!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       60, BALLOON_FRAME_TYPE_BUC,            "Stolen? But... who on earth could have...?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,       61, BALLOON_FRAME_TYPE_BUC,            "...Who else would do something like this,<CR>other than that person" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       62, BALLOON_FRAME_TYPE_BUC,            "That person... could it be..." },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    63, BALLOON_FRAME_TYPE_BUC,            "Fufu, as expected of Kuu-chan.<CR>You're very perceptive" },
	// ▼The master appears
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       64, BALLOON_FRAME_TYPE_BUC,            "M-master...?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_AKI,    BUC_POSITION_TYPE_R,       65, BALLOON_FRAME_TYPE_BUC,            "You're back sooner than expected.<CR>I thought for sure you'd cause some problem<CR>and get kicked out of some other town?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,       66, BALLOON_FRAME_TYPE_BUC,            "And stop calling me Kuu-chan" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      67, BALLOON_FRAME_TYPE_BUC,            "No, I just decided to get serious<CR>and reopen the atelier business,<CR>and it became surprisingly successful" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R2,      68, BALLOON_FRAME_TYPE_BUC,            "So I'm opening a second shop<CR>in this town to further expand the business" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       -1, BALLOON_FRAME_TYPE_BUC,            "………." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_IKA,     BUC_POSITION_TYPE_R2,      70, BALLOON_FRAME_TYPE_BUC,            "So, Rorona.<CR>While we had a close master-student relationship a year ago,<CR>from today we're rivals..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX1,     BUC_POSITION_TYPE_L,       71, BALLOON_FRAME_TYPE_BUC,            "M-master--!!" },
	// ▼Illustration display
	// ▼Rorona crying and hugging her master
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    72, BALLOON_FRAME_TYPE_BUC,            "Now, now...<CR>Were you not listening to me?" },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    73, BALLOON_FRAME_TYPE_BUC,            "This isn't a touching reunion,<CR>but a scene where she finds a new rival<CR>and burns with fighting spirit..." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    74, BALLOON_FRAME_TYPE_BUC,            "Waaaaaaaah! Master! Master--!!" },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    75, BALLOON_FRAME_TYPE_BUC,            "...Good grief. Before, you wouldn't<CR>hug me even if I asked.<CR>When did you become such a crybaby?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    76, BALLOON_FRAME_TYPE_BUC,            "Because, because... waaaaaaaah" },
	{ BALLOON_MODE_BUCSYS, CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_NONE,           BUC_POSITION_TYPE_NONE,    77, BALLOON_FRAME_TYPE_BUC,            "...Everyone's staring" },
	{ BALLOON_MODE_BUCSYS, CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_NONE,           BUC_POSITION_TYPE_NONE,    78, BALLOON_FRAME_TYPE_BUC,            "Honestly.<CR>You should have expected this would happen.<CR>You should've just come back normally" },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    79, BALLOON_FRAME_TYPE_BUC,            "Well, I mean, I was embarrassed,<CR>so I took a detour..." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    80, BALLOON_FRAME_TYPE_BUC,            "Waaaaaaaah. You dummy, master..." },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    81, BALLOON_FRAME_TYPE_BUC,            "Quiet. You don't have to tell me, I already know" },
	{ BALLOON_MODE_BUCSYS, CHARA_ASTRID,     0, NAME_ASTRID,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    82, BALLOON_FRAME_TYPE_BUC,            "...Can't be helped.<CR>I'll let you be spoiled for today only.<CR>Today only, you hear?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    83, BALLOON_FRAME_TYPE_BUC,            "Sniff, ugh... waaaaaaah..." },
