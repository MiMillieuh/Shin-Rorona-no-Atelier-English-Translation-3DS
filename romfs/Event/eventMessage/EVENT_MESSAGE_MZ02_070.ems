	{ BALLOON_MODE_BUC,    CHARA_YKSEL,      0, NAME_YKSEL,       BUC_YKSEL_NOR,      BUC_POSITION_TYPE_R,       15, BALLOON_FRAME_TYPE_BUC,            "As usual. It's a battlefield...<CR>Here, I brought you some food" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L2,      16, BALLOON_FRAME_TYPE_BUC,            "Ixel-kun, thanks!<CR>I haven't eaten anything since morning!" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R2,      17, BALLOON_FRAME_TYPE_BUC,            "Perfect timing!<CR>I could use an extra pair of hands too.<CR>You should help too!" },
