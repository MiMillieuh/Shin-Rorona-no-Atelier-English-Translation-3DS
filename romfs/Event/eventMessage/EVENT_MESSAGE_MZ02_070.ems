	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_NOR,    BUC_POSITION_TYPE_L,       19, BALLOON_FRAME_TYPE_BUC,            "Ah, um, I'll make some tea, okay?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L2,      20, BALLOON_FRAME_TYPE_BUC,            "Yeah, thanks. Well then, let's take a short break..." },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_IKA,    BUC_POSITION_TYPE_R2,      21, BALLOON_FRAME_TYPE_BUC,            "You don't have time for that!<CR>Eat while you work!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NAKI,    BUC_POSITION_TYPE_L2,      22, BALLOON_FRAME_TYPE_BUC,            "Th-that's..." },
	// ▼
	{ BALLOON_MODE_SYSTEM, CHARA_NONE,       0, NAME_NONE,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    -1, BALLOON_FRAME_TYPE_NORMAL,         "Even so, with the support of her friends, she somehow managed to get through the busy days" },
	// ▼Sterk and Gio talking in front of the castle gate
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KANA,     BUC_POSITION_TYPE_L,       24, BALLOON_FRAME_TYPE_BUC,            "...So, what are you<CR>doing standing around here again?" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_KANA,       BUC_POSITION_TYPE_R,       25, BALLOON_FRAME_TYPE_BUC,            "Same as always.<CR>I was asked to help her" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_IKA,      BUC_POSITION_TYPE_L,       26, BALLOON_FRAME_TYPE_BUC,            "Before helping others,<CR>please do your own work!" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_IKA,        BUC_POSITION_TYPE_R,       27, BALLOON_FRAME_TYPE_BUC,            "What about you? I hear you've been<CR>slacking off on your knight duties lately" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KOMA,     BUC_POSITION_TYPE_L,       28, BALLOON_FRAME_TYPE_BUC,            "Ugh, that's... it can't be helped!<CR>She's the one who's busier!" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_KANA,       BUC_POSITION_TYPE_R,       29, BALLOON_FRAME_TYPE_BUC,            "Same here. Isn't that fine?<CR>In a country where even the King works hard,<CR>the future looks bright" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_IKA,      BUC_POSITION_TYPE_L,       30, BALLOON_FRAME_TYPE_BUC,            "Don't justify yourself!" },
	{ BALLOON_MODE_CHASYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    31, BALLOON_FRAME_TYPE_NORMAL,         "S-sorry for the wait!<CR>I'm really sorry, but please<CR>save the fighting for later!" },
	// ▼Another scene change
	// ▼Tantoris entering the castle
	{ BALLOON_MODE_BUC,    CHARA_ESTIY,      0, NAME_ESTIY,       BUC_ESTIY_NOR,      BUC_POSITION_TYPE_R,       32, BALLOON_FRAME_TYPE_BUC,            "Oh my. Good morning.<CR>It's unusual for you to be here this early" },
	{ BALLOON_MODE_BUC,    CHARA_TANTORIS,   0, NAME_TANTORIS_B,  BUC_TANTORIS_SIN,   BUC_POSITION_TYPE_L,       33, BALLOON_FRAME_TYPE_BUC,            "Yes. I wanted to see you<CR>as soon as possible,<CR>I couldn't sleep a wink last night..." },
	{ BALLOON_MODE_BUC,    CHARA_ESTIY,      0, NAME_ESTIY,       BUC_ESTIY_WARA,     BUC_POSITION_TYPE_R,       34, BALLOON_FRAME_TYPE_BUC,            "There, there.<CR>You probably got scolded by the minister again, right?<CR>You seemed really irritated" },
	{ BALLOON_MODE_BUC,    CHARA_TANTORIS,   0, NAME_TANTORIS_B,  BUC_TANTORIS_KANA,  BUC_POSITION_TYPE_L,       35, BALLOON_FRAME_TYPE_BUC,            "You saw right through me...<CR>Well, at least today I won't have to listen to a lecture..." },
	{ BALLOON_MODE_BUCSYS, CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    36, BALLOON_FRAME_TYPE_BUC,            "Hey! Tristan!" },
	{ BALLOON_MODE_BUC,    CHARA_ESTIY,      0, NAME_ESTIY,       BUC_ESTIY_NOR,      BUC_POSITION_TYPE_R,       37, BALLOON_FRAME_TYPE_BUC,            "...He seems mad, though?" },
	{ BALLOON_MODE_BUC,    CHARA_TANTORIS,   0, NAME_TANTORIS_B,  BUC_TANTORIS_IKA,   BUC_POSITION_TYPE_L,       38, BALLOON_FRAME_TYPE_BUC,            "So it seems...<CR>Hey, I wasn't late today, was I?" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_IKA,   BUC_POSITION_TYPE_R2,      39, BALLOON_FRAME_TYPE_BUC,            "It's your appearance! Your appearance!<CR>A future minister like you,<CR>how long are you going to keep dressing so flashy...!" },
	{ BALLOON_MODE_BUC,    CHARA_TANTORIS,   0, NAME_TANTORIS_B,  BUC_TANTORIS_NOR,   BUC_POSITION_TYPE_L,       40, BALLOON_FRAME_TYPE_BUC,            "Aah, sorry, I'll fix it soon.<CR>More importantly, did you<CR>look over the documents I submitted?" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_NOR,   BUC_POSITION_TYPE_R2,      41, BALLOON_FRAME_TYPE_BUC,            "Ah, yes. The additional budget for alchemy<CR>and the ateliers using it as their business..." },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_NOR,   BUC_POSITION_TYPE_R2,      42, BALLOON_FRAME_TYPE_BUC,            "It wasn't bad, but<CR>isn't it a bit too favorable?" },
	{ BALLOON_MODE_BUC,    CHARA_TANTORIS,   0, NAME_TANTORIS_B,  BUC_TANTORIS_WARA,  BUC_POSITION_TYPE_L,       43, BALLOON_FRAME_TYPE_BUC,            "Isn't it fine? If we're thinking about the people's interests,<CR>we need alchemy to do its part right now" },
	{ BALLOON_MODE_BUC,    CHARA_MERIODUS,   0, NAME_MERIODUS,    BUC_MERIODUS_NOR,   BUC_POSITION_TYPE_R2,      44, BALLOON_FRAME_TYPE_BUC,            "Hmm, but..." },
