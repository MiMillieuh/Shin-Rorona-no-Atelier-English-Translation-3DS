	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       -1, BALLOON_FRAME_TYPE_BUC,            "..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       -1, BALLOON_FRAME_TYPE_BUC,            "...." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       -1, BALLOON_FRAME_TYPE_BUC,            "............" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_R,       30, BALLOON_FRAME_TYPE_BUC,            "Master. Does the town really mean that much to you?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       31, BALLOON_FRAME_TYPE_BUC,            "Wha!? N-no, that's not...<CR>Maybe a little..." },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_NOR,      BUC_POSITION_TYPE_R,       32, BALLOON_FRAME_TYPE_BUC,            "So Hom told you many times,<CR>you should stop sneaking off<CR>acting cool like that" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       33, BALLOON_FRAME_TYPE_BUC,            "I wasn't trying to be cool or anything.<CR>I just thought it would be more lonely<CR>otherwise..." },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    34, BALLOON_FRAME_TYPE_BUC,            "Then let me fill that loneliness,<CR>if I may" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       35, BALLOON_FRAME_TYPE_BUC,            "Eh...?" },
	// ★一枚絵
	// ▼木の幹かなんかによっかかって、かっこつけたポーズのタントリスと、
	// ▼それを見て驚きつつ、ちょっと顔を赤らめてるロロナ
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    36, BALLOON_FRAME_TYPE_BUC,            "Tantris-san!? Why are you...?<CR>But it was so long ago... Eh?" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    37, BALLOON_FRAME_TYPE_BUC,            "Well, there are many reasons...<CR>If I had to say, I'd call it fate.<CR>Yours and mine" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    38, BALLOON_FRAME_TYPE_BUC,            "...What is that supposed to mean?" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    39, BALLOON_FRAME_TYPE_BUC,            "Huh?<CR>I thought you'd be more embarrassed" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    40, BALLOON_FRAME_TYPE_BUC,            "I've gotten used to it.<CR>You've trained me well, Tant-san" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    41, BALLOON_FRAME_TYPE_BUC,            "That's both gratifying and disappointing..." },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    42, BALLOON_FRAME_TYPE_BUC,            "Well, enough with the greetings.<CR>Traveling alone gets lonely,<CR>so would you mind if I tagged along?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    43, BALLOON_FRAME_TYPE_BUC,            "Of course... ah, well then,<CR>if you'd just promise not to say<CR>embarrassing things anymore" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    44, BALLOON_FRAME_TYPE_BUC,            "Didn't you just say you got used to it?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    45, BALLOON_FRAME_TYPE_BUC,            "I got used to it, but it's still embarrassing" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    46, BALLOON_FRAME_TYPE_BUC,            "Alright. I promise" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    47, BALLOON_FRAME_TYPE_BUC,            "Yes. Well then, please take care of me" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    48, BALLOON_FRAME_TYPE_BUC,            "Likewise. Shall we get going?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    49, BALLOON_FRAME_TYPE_BUC,            "Yes. ...wait, waaaah!<CR>Wh-why are your hands on my shoulders!<CR>W-waah, let go!" },
	{ BALLOON_MODE_BUCSYS, CHARA_TANTORIS,   0, NAME_TANTORIS,    BUC_NONE,           BUC_POSITION_TYPE_NONE,    50, BALLOON_FRAME_TYPE_BUC,            "Is that not allowed?<CR>You told me not to say embarrassing things,<CR>so I showed you instead" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    51, BALLOON_FRAME_TYPE_BUC,            "Actions are not allowed either! P-please stop!" },
