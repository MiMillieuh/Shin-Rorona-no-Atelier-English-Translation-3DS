BalloonData QC01_650_EMS[] = {
	// ▼Master and Cuderira watching Rorona work
	// ★※No special conditions
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L,        0, BALLOON_FRAME_TYPE_BUC,            "What a shame. I came all this way to visit,<CR>yet she can't even spare time for us" },
