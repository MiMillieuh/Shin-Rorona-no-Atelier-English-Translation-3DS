	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_AKI,      BUC_POSITION_TYPE_R,       20, BALLOON_FRAME_TYPE_BUC,            "With your friends, huh... It's not prohibited, but<CR>outside the town is extremely dangerous.<CR>I'd like you to be more mindful of your safety" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       21, BALLOON_FRAME_TYPE_BUC,            "B-But... If I don't gather materials outside,<CR>the atelier will..." },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       22, BALLOON_FRAME_TYPE_BUC,            "I understand it's for the atelier's survival,<CR>but if something happened to you -<CR>or worse, if you lost your life..." },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KANA,     BUC_POSITION_TYPE_R,       23, BALLOON_FRAME_TYPE_BUC,            "No, the root cause is that order from the kingdom.<CR>It would be wrong of me to blame you" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       24, BALLOON_FRAME_TYPE_BUC,            "Sigh..." },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KOMA,     BUC_POSITION_TYPE_R,       25, BALLOON_FRAME_TYPE_BUC,            "But that doesn't mean... hmm...<CR>Very well, then let me propose something" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "From now on, whenever you go outside the town,<CR>I will accompany you as much as possible" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       27, BALLOON_FRAME_TYPE_BUC,            "...Eh? You, Sterk-san?" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       28, BALLOON_FRAME_TYPE_BUC,            "Of course,<CR>if it would be a bother, I won't force it..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       29, BALLOON_FRAME_TYPE_BUC,            "N-No!<CR>It's not a bother at all!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       30, BALLOON_FRAME_TYPE_BUC,            "B-But is it really okay?<CR>Don't you have castle duties, Sterk-san?" },
