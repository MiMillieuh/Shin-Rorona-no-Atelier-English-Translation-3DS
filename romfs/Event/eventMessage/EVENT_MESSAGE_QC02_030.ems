	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_IKA,      BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "Don't put me in the same category as you!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L,       20, BALLOON_FRAME_TYPE_BUC,            "Fufu, just kidding. Glad to see<CR>your kindness hasn't changed one bit" },
