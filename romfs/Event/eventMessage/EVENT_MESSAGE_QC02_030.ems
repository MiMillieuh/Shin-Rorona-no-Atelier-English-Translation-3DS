	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L,       22, BALLOON_FRAME_TYPE_BUC,            "I'm giving you a compliment. Take it sincerely.<CR>Well, as your master,<CR>let me bow my head just this once" },
