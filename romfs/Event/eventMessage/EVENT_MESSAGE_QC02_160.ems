	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_ODO,      BUC_POSITION_TYPE_R,        9, BALLOON_FRAME_TYPE_BUC,            "Compensation? I don't recall doing anything for you..." },
