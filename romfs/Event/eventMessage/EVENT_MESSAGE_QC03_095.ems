	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L2,      87, BALLOON_FRAME_TYPE_BUC,            "If you realize your mistake, just fix it.<CR>You're still young, after all." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_R2,      88, BALLOON_FRAME_TYPE_BUC,            "Ah, looks like they're done over there too." },
	{ BALLOON_MODE_BUC,    CHARA_YKSEL,      0, NAME_YKSEL,       BUC_YKSEL_NOR,      BUC_POSITION_TYPE_R,       89, BALLOON_FRAME_TYPE_BUC,            "Rorona!<CR>You're my lifelong rival!" },
	{ BALLOON_MODE_BUC,    CHARA_YKSEL,      0, NAME_YKSEL,       BUC_YKSEL_WARA,     BUC_POSITION_TYPE_R,       90, BALLOON_FRAME_TYPE_BUC,            "Let's keep honing our cooking skills together!<CR>Got it!?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_R2,      91, BALLOON_FRAME_TYPE_BUC,            "Well, I'm not particularly trying to master cooking..." },
	{ BALLOON_MODE_BUC,    CHARA_YKSEL,      0, NAME_YKSEL,       BUC_YKSEL_SIN,      BUC_POSITION_TYPE_R,       92, BALLOON_FRAME_TYPE_BUC,            "I can't sit still!<CR>I'm going home to train from scratch!<CR>I'm fired up!!" },
	// ▼アトリエを飛び出していくイクセル
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_R2,      93, BALLOON_FRAME_TYPE_BUC,            "...Master, what did you say to Ixsel-kun...?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_L2,      94, BALLOON_FRAME_TYPE_BUC,            "I didn't say anything that big...<CR>It seems like he has one of those personalities<CR>that heats up quickly and cools down fast." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L2,      95, BALLOON_FRAME_TYPE_BUC,            "Now, enough about that.<CR>More importantly, make me dinner. ASAP." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_R2,      96, BALLOON_FRAME_TYPE_BUC,            "What!? Cooking again!?<CR>Wasn't the food I just made enough?" },
	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_KANA,     BUC_POSITION_TYPE_L,       97, BALLOON_FRAME_TYPE_BUC,            "Sorry, Master.<CR>I ate it all, so there's nothing left." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_WARA,    BUC_POSITION_TYPE_L2,      98, BALLOON_FRAME_TYPE_BUC,            "That's that.<CR>I want you to make me a dish that can rival<CR>the one you just served in the competition." },
