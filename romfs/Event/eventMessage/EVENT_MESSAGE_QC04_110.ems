	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       23, BALLOON_FRAME_TYPE_BUC,            "Yeah. When I was little, I used to read picture books about<CR>girls waving wands around like this..." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_KANA,   BUC_POSITION_TYPE_R,       24, BALLOON_FRAME_TYPE_BUC,            "But everyone was scared of me...<CR>They called me 'witch' and 'witch'...<CR>Everyone around me..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       25, BALLOON_FRAME_TYPE_BUC,            "Eh...?" },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_KANA,   BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "Everyone was scared and hated me,<CR>and eventually I couldn't live in the village anymore, so I was driven out..." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_NAKI,   BUC_POSITION_TYPE_R,       27, BALLOON_FRAME_TYPE_BUC,            "After a while, even my mom and dad<CR>started looking at me coldly..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       28, BALLOON_FRAME_TYPE_BUC,            "Rio-chan...? U-um..." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_NAKI,   BUC_POSITION_TYPE_R,       29, BALLOON_FRAME_TYPE_BUC,            "So that's why I left home with these guys...<CR>But no matter where we go, it's the same...<CR>Once people find out about my power, everyone gets scared..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       30, BALLOON_FRAME_TYPE_BUC,            "Rio-chan. T-that's enough, okay?" },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_NAKI,   BUC_POSITION_TYPE_R,       31, BALLOON_FRAME_TYPE_BUC,            "The reason I started doing puppet shows<CR>wasn't just to change my personality, you know...<CR>It was also to hide this power..." },
