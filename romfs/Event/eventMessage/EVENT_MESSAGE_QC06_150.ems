	{ BALLOON_MODE_CHARA,  CHARA_GIO_SPEV,   0, NAME_GIO,         BUC_NONE,           BUC_POSITION_TYPE_NONE,    10, BALLOON_FRAME_TYPE_NORMAL,         "Pardon the intrusion.<CR>I have a few questions for you" },
