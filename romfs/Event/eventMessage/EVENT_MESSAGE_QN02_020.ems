	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_NAZO,        BUC_HOM_M_NOR,      BUC_POSITION_TYPE_R,       -1, BALLOON_FRAME_TYPE_BUC,            "............" },
