	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_R,       12, BALLOON_FRAME_TYPE_BUC,            "Hmm. I'll have a look at it once it returns." },
