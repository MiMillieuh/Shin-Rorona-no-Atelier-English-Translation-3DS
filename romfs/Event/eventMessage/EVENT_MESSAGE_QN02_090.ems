	{ BALLOON_MODE_BUC,    CHARA_RORO_PA,    0, NAME_RORO_PA,     BUC_RORO_PA_SIN,    BUC_POSITION_TYPE_R2,      22, BALLOON_FRAME_TYPE_BUC,            "Who's the cheater here!<CR>I keep telling you, I don't know anything about this!" },
	{ BALLOON_MODE_BUC,    CHARA_RORO_MA,    0, NAME_RORO_MA,     BUC_RORO_MA_IKA,    BUC_POSITION_TYPE_R,       23, BALLOON_FRAME_TYPE_BUC,            "Don't play innocent with me!<CR>The evidence is standing right here in front of us,<CR>and you still say that!" },
	{ BALLOON_MODE_BUC,    CHARA_RORO_PA,    0, NAME_RORO_PA,     BUC_RORO_PA_SIN,    BUC_POSITION_TYPE_R2,      24, BALLOON_FRAME_TYPE_BUC,            "Those are my words to say! You're the one who—!" },
	{ BALLOON_MODE_BUC,    CHARA_RORO_MA,    0, NAME_RORO_MA,     BUC_RORO_MA_IKA,    BUC_POSITION_TYPE_R,       25, BALLOON_FRAME_TYPE_BUC,            "My goodness!<CR>Are you saying you can't even trust your own wife!" },
