	{ BALLOON_MODE_BUC,    CHARA_RORO_PA,    0, NAME_RORO_PA,     BUC_RORO_PA_SIN,    BUC_POSITION_TYPE_R2,       6, BALLOON_FRAME_TYPE_BUC,            "Homunculus... what's that?" },
	{ BALLOON_MODE_BUC,    CHARA_RORO_MA,    0, NAME_RORO_MA,     BUC_RORO_MA_SIN,    BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "Don't ask me...<CR>But if you call Rorona 'Master',<CR>does that make you Rorona's apprentice?" },
