	{ BALLOON_MODE_BUC,    CHARA_RORO_MA,    0, NAME_RORO_MA,     BUC_RORO_MA_SIN,    BUC_POSITION_TYPE_R,       20, BALLOON_FRAME_TYPE_BUC,            "What are you saying! If you follow this cheating husband,<CR>you'll only end up miserable!<CR>You'll come with Mommy, won't you?" },
