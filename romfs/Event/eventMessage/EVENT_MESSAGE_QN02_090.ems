	{ BALLOON_MODE_BUC,    CHARA_HOM_M,      0, NAME_HOM_M,       BUC_HOM_M_KANA,     BUC_POSITION_TYPE_R,       29, BALLOON_FRAME_TYPE_BUC,            "I am sorry.<CR>There are still many things<CR>that Hom doesn't understand." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L,       30, BALLOON_FRAME_TYPE_BUC,            "Never mind. I am the root cause, after all.<CR>I'll step in to mediate once they've cooled down a bit." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    31, BALLOON_FRAME_TYPE_BUC,            "Master!<CR>Stop standing there watching and please help me—!" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORO_PA,    0, NAME_RORO_PA,     BUC_NONE,           BUC_POSITION_TYPE_NONE,    32, BALLOON_FRAME_TYPE_BUC,            "Come on, Rorona! You're coming with me!" },
