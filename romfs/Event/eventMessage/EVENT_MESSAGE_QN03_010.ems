	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       20, BALLOON_FRAME_TYPE_BUC,            "...That's not what I meant to say. Thank you, old man." },
