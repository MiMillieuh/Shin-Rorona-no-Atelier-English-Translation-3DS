	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L,       19, BALLOON_FRAME_TYPE_BUC,            "An alchemist is essentially a craftsman.<CR>You should take pride in faithfully<CR>fulfilling the work you're asked to do..." },
