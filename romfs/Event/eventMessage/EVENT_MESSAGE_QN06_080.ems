	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L,       23, BALLOON_FRAME_TYPE_BUC,            "Phew. Somehow we managed to smooth things over." },
	{ BALLOON_MODE_BUC,    CHARA_ESTIY,      0, NAME_ESTIY,       BUC_ESTIY_SIN,      BUC_POSITION_TYPE_R,       24, BALLOON_FRAME_TYPE_BUC,            "...But I feel like she got<CR>the completely wrong idea, don't you?" },
