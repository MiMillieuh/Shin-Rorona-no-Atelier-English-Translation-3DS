	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L,       14, BALLOON_FRAME_TYPE_BUC,            "Even this receptionist here has<CR>certainly peculiar hobbies and quirks<CR>she wouldn't tell anyone about." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L,       15, BALLOON_FRAME_TYPE_BUC,            "Refraining from asking is<CR>the kind thing to do." },
	{ BALLOON_MODE_BUC,    CHARA_ESTIY,      0, NAME_ESTIY,       BUC_ESTIY_ODO,      BUC_POSITION_TYPE_R,       16, BALLOON_FRAME_TYPE_BUC,            "Excuse me, Astrid-san!<CR>That phrasing makes it sound like..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_R2,      17, BALLOON_FRAME_TYPE_BUC,            "R-Right! That makes so much sense!<CR>I'm sorry! I'm such a<CR>thoughtless person, aren't I!" },
