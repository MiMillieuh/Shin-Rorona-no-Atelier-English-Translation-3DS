BalloonData YM03_010_EMS[] = {
	// ▼本編中で発生（延長戦では発生しない）
	// ●本編中のアストリッド関連のいずれかのイベントとチェインさせる
	// ●アストリッドの賃金は９９８０コール
	// ▼アトリエにいると、アストリッドが話しかけてくる
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NAKI,    BUC_POSITION_TYPE_L,        0, BALLOON_FRAME_TYPE_BUC,            "Haah... My body is so sore" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_R,        1, BALLOON_FRAME_TYPE_BUC,            "What's wrong, Rorona. At your young age,<CR>complaining like an old person like that,<CR>does not bode well for your future" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,        2, BALLOON_FRAME_TYPE_BUC,            "No, that's not what I meant by sore" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,        3, BALLOON_FRAME_TYPE_BUC,            "These days, I've been going to places where<CR>pretty strong monsters show up,<CR>so I keep getting banged up and<CR>can't seem to catch a break..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,        4, BALLOON_FRAME_TYPE_BUC,            "As an alchemist, you should be able to go to those places.<CR>What use are you if you can't even do that?<CR>There are plenty more dangerous places ahead, you know" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,        5, BALLOON_FRAME_TYPE_BUC,            "That's pretty tough to hear...<CR>Master, aren't you ever bothered by those places?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,        6, BALLOON_FRAME_TYPE_BUC,            "Of course not. In principle,<CR>there are no places in all of Arland<CR>that pose a challenge to me" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "...Actually, let me show you a place<CR>that even YOU couldn't handle.<CR>Something real soft and cushy, I wonder" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L,        8, BALLOON_FRAME_TYPE_BUC,            "Master is!?<CR>Really!?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,        9, BALLOON_FRAME_TYPE_BUC,            "Of course.<CR>Fear, respect, and worship my power" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       10, BALLOON_FRAME_TYPE_BUC,            "Whee, yay!<CR>If Master's coming, that's reassuring!" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,       11, BALLOON_FRAME_TYPE_BUC,            "But even between master and disciple,<CR>I'm charging you properly.<CR>Well, it's only ten thousand cole, after all.<CR>That's quite the bargain, wouldn't you say?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       12, BALLOON_FRAME_TYPE_BUC,            "One...!<CR>Ten thousand cole just to go ONCE!?<CR>That's insane!" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_IKA,     BUC_POSITION_TYPE_L,       13, BALLOON_FRAME_TYPE_BUC,            "...Oh, I get it now. You never intended<CR>to help me in the first place, did you?<CR>I got excited for nothing" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_R,       14, BALLOON_FRAME_TYPE_BUC,            "How insulting. I simply quoted a price<CR>befitting my skill, I wonder what a way<CR>to be spoken to. To think my heart was so tainted" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_R,       15, BALLOON_FRAME_TYPE_BUC,            "Without any tricks or ulterior motives,<CR>I'm simply offering to help you.<CR>Rorona, you really are hopeless" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L,       16, BALLOON_FRAME_TYPE_BUC,            "But ten thousand cole, you know?<CR>There's no way I can take that seriously.<CR>Ahhh, I really wanted to see<CR>how strong you really are..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_TERE,    BUC_POSITION_TYPE_R,       17, BALLOON_FRAME_TYPE_BUC,            "Since you've gone that far, I have no choice.<CR>I'm in a good mood right now, so I'll make a special discount.<CR>Savor this moment and be grateful" },
