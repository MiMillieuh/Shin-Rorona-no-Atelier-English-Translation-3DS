BalloonData YM03_080_EMS[] = {
	// ▼流浪の最強冒険者が発生している（しばらく経過）
	// ●延長戦開始～戻ってきた師匠が発生するまでの期間では発生しない
	// ●発生後はギゼラを仲間にできる
	// ●ギゼラ参戦時にレベル１からかレベル５０からか選べる
	// ▼アトリエにいると発生
	// ▼入り口ノック
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,        0, BALLOON_FRAME_TYPE_BUC,            "Excuse me, is there a girl<CR>in need of a bodyguard?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,        1, BALLOON_FRAME_TYPE_BUC,            "Huh? Who might you be?" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_WARA,    BUC_POSITION_TYPE_R,        2, BALLOON_FRAME_TYPE_BUC,            "Oh right, I forgot to introduce myself.<CR>I'm Gisela.<CR>Gisela Hermort" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,        3, BALLOON_FRAME_TYPE_BUC,            "I heard about you at the castle, then asked<CR>people I met on the road, and found my way here" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,        4, BALLOON_FRAME_TYPE_BUC,            "Could it be... maybe it's about me..." },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_WARA,    BUC_POSITION_TYPE_R,        5, BALLOON_FRAME_TYPE_BUC,            "Ahahaha, is that so? Then let's make this quick.<CR>Would you like to hire me?<CR>I'll lower the price" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,        6, BALLOON_FRAME_TYPE_BUC,            "W-Well, let me think..." },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "Well, showing up unannounced<CR>and asking might be a bit much.<CR>But I'm pretty confident in my skills,<CR>so if anything comes up, just call out to me" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,        8, BALLOON_FRAME_TYPE_BUC,            "Yes, if anything comes up,<CR>please take care of me" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,        9, BALLOON_FRAME_TYPE_BUC,            "Thanks. My funds are getting<CR>pretty thin right now, so<CR>I'd be grateful if you hired me" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_SIN,     BUC_POSITION_TYPE_R,       10, BALLOON_FRAME_TYPE_BUC,            "Oh right, I have a question.<CR>If I were to protect you,<CR>how would you like me to do it?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       11, BALLOON_FRAME_TYPE_BUC,            "...?<CR>What do you mean?" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_SIN,     BUC_POSITION_TYPE_R,       12, BALLOON_FRAME_TYPE_BUC,            "I'm confident in my strength.<CR>I want to train, so<CR>I'd like some kind of restraint" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,       13, BALLOON_FRAME_TYPE_BUC,            "But since I'm working as a bodyguard,<CR>I want to do it properly too.<CR>That's why I'm asking how you want me to" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,       14, BALLOON_FRAME_TYPE_BUC,            "Would you prefer I put on some restraints<CR>and weaken myself a bit, or<CR>would you rather I go all out from the start?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       15, BALLOON_FRAME_TYPE_BUC,            "U-Um..." },
	// ▼「鍛えるのを優先でいいですよ」と答えた場合
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_WARA,    BUC_POSITION_TYPE_R,       16, BALLOON_FRAME_TYPE_BUC,            "Got it. In that case, I'd need to prepare<CR>weights to attach to my limbs" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,       17, BALLOON_FRAME_TYPE_BUC,            "If I wear those, I wonder if my movements would be restricted.<CR>I'd get pretty weak fighting in that state" },
	// ▼アストリッド登場
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L2,      18, BALLOON_FRAME_TYPE_BUC,            "Hold on just a moment.<CR>I've heard enough about the situation.<CR>You're doing something interesting" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L2,      19, BALLOON_FRAME_TYPE_BUC,            "In that case, I have just the thing for you.<CR>Try putting this on" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_KAN,     BUC_POSITION_TYPE_R,       20, BALLOON_FRAME_TYPE_BUC,            "Hmm? What's this?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L2,      21, BALLOON_FRAME_TYPE_BUC,            "It's a bracelet that completely<CR>prevents you from using any strength<CR>while wearing it. Much better than weights,<CR>no bulk, and the effect is guaranteed" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_L2,      22, BALLOON_FRAME_TYPE_BUC,            "...I originally made this to<CR>subdue wild beasts" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_WARA,    BUC_POSITION_TYPE_R,       23, BALLOON_FRAME_TYPE_BUC,            "Let me try...<CR>Ohhh, I can definitely feel the energy draining from my body.<CR>This'll be great training" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L2,      24, BALLOON_FRAME_TYPE_BUC,            "When you take off the bracelet,<CR>you'll probably have incredible power" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L2,      25, BALLOON_FRAME_TYPE_BUC,            "I'm very curious to see what happens<CR>when a person wears this.<CR>I'd love to see you test it" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "I like it, I'll take it.<CR>Well then, no more objections,<CR>I'll leave the bodyguard work to you" },
	// ▼ギゼラ立ち去る
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_L2,      27, BALLOON_FRAME_TYPE_BUC,            "Fu, quite an interesting one.<CR>This'll be fun" },
	// ▼アストリッド立ち去る
	// ▼「最強の強さで守って欲しい」と答えた場合
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_WARA,    BUC_POSITION_TYPE_R,       28, BALLOON_FRAME_TYPE_BUC,            "Ahahaha, got it!<CR>I'll go all out!" },
	{ BALLOON_MODE_BUC,    CHARA_GISELA,     0, NAME_GISELA,      BUC_GISELA_NOR,     BUC_POSITION_TYPE_R,       29, BALLOON_FRAME_TYPE_BUC,            "That said, I can't hold back,<CR>so be careful not to get caught in the crossfire.<CR>Well then, I'm looking forward to your call" },
	// ▼ギゼラ立ち去る
