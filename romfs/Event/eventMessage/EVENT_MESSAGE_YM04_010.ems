	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_NAZO,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    10, BALLOON_FRAME_TYPE_BUCSYS,         "It's this place, Meruru-chan" },
	{ BALLOON_MODE_BUCSYS, CHARA_MERURU,     0, NAME_NAZO,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    11, BALLOON_FRAME_TYPE_BUCSYS,         "This is that place...<CR>I really hope nobody's home..." },
	// ▼スチル表示（アトリエの入り口に疲れてる感じのトトリとメルル、その二人を見て驚いているロロナ）
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    12, BALLOON_FRAME_TYPE_BUCSYS,         "U-Um... Who are you...?" },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_NAZO,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    13, BALLOON_FRAME_TYPE_BUCSYS,         "Ahh! Rorona-sensei!<CR>Finally I found you!" },
	{ BALLOON_MODE_BUCSYS, CHARA_MERURU,     0, NAME_NAZO,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    14, BALLOON_FRAME_TYPE_BUCSYS,         "So this is Rorona-chan... no wait,<CR>Rorona-san, I suppose?<CR>Now that I see you, I get what you mean" },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_NAZO,        BUC_NONE,           BUC_POSITION_TYPE_NONE,    15, BALLOON_FRAME_TYPE_BUCSYS,         "That's right.<CR>I'm not sure if this will work out..." },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    16, BALLOON_FRAME_TYPE_BUCSYS,         "S-Sensei!?<CR>Um, I don't think I know anyone<CR>who calls me that..." },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_TOTORI,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    17, BALLOON_FRAME_TYPE_BUCSYS,         "Ah, that's right, we haven't met yet.<CR>I'm Totori. And this is Meruru-chan" },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_TOTORI,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    18, BALLOON_FRAME_TYPE_BUCSYS,         "The two of us were sent here<CR>from a future world by some kind of accident" },
	{ BALLOON_MODE_BUCSYS, CHARA_MERURU,     0, NAME_MERURU,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    19, BALLOON_FRAME_TYPE_BUCSYS,         "More precisely, we came from a place<CR>pretty far northwest of here,<CR>the Arsland Kingdom" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    20, BALLOON_FRAME_TYPE_BUCSYS,         "Um, well......" },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_TOTORI,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    21, BALLOON_FRAME_TYPE_BUCSYS,         "Sorry for just dumping all this on you" },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_TOTORI,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    22, BALLOON_FRAME_TYPE_BUCSYS,         "...I guess it's hard to believe, right?<CR>Even for you, Rorona-sensei" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    23, BALLOON_FRAME_TYPE_BUCSYS,         "Y-Yeah... Ehahaha" },
	{ BALLOON_MODE_BUCSYS, CHARA_TOTORI,     0, NAME_TOTORI,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    24, BALLOON_FRAME_TYPE_BUCSYS,         "...But, what if I told you the item<CR>we used to come here was made by<CR>Miss Astrid? Would you believe me then?" },
	{ BALLOON_MODE_BUCSYS, CHARA_RORONA,     0, NAME_RORONA,      BUC_NONE,           BUC_POSITION_TYPE_NONE,    25, BALLOON_FRAME_TYPE_BUCSYS,         "What!? Master's!?" },
