	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_SIN,     BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "That's the situation" },
	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_NOR,     BUC_POSITION_TYPE_R2,      27, BALLOON_FRAME_TYPE_BUC,            "Just as Totori-sensei predicted, huh?<CR>Saying Miss Astrid's name<CR>was enough to make you believe" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       28, BALLOON_FRAME_TYPE_BUC,            "Well, there's no helping that, right?<CR>Master would totally do something like that.<CR>I believe you, I suppose" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_WARA,    BUC_POSITION_TYPE_R,       29, BALLOON_FRAME_TYPE_BUC,            "Thank you for believing us, Rorona-sensei" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_TERE,    BUC_POSITION_TYPE_L,       30, BALLOON_FRAME_TYPE_BUC,            "Totori-chan, was it?<CR>C-Can you maybe not call me<CR>Rorona-sensei? It's making me feel all bashful" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_KAN,     BUC_POSITION_TYPE_R,       31, BALLOON_FRAME_TYPE_BUC,            "But in the world we came from,<CR>Rorona-sensei was our teacher...<CR>Can't I just call you Rorona-sensei?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX1,     BUC_POSITION_TYPE_L,       32, BALLOON_FRAME_TYPE_BUC,            "Uugh~" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_NOR,     BUC_POSITION_TYPE_R,       33, BALLOON_FRAME_TYPE_BUC,            "...So anyway, getting back on track,<CR>we came here to find a way<CR>back to our time" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_KOMA,    BUC_POSITION_TYPE_R,       34, BALLOON_FRAME_TYPE_BUC,            "The item that caused this was made by<CR>Miss Astrid, I suppose, so I thought<CR>she might know something..." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,       35, BALLOON_FRAME_TYPE_BUC,            "Master left on a journey a while ago.<CR>I don't know when she'll be back<CR>either" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_ODO,     BUC_POSITION_TYPE_R,       36, BALLOON_FRAME_TYPE_BUC,            "What!? Really!?" },
	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_KOMA,    BUC_POSITION_TYPE_R2,      37, BALLOON_FRAME_TYPE_BUC,            "We didn't account for that!<CR>What should we do, Totori-sensei?" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_KOMA,    BUC_POSITION_TYPE_R,       38, BALLOON_FRAME_TYPE_BUC,            "Not having Miss Astrid here<CR>makes things tricky...<CR>Looks like returning right away isn't possible..." },
