	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_AKI,      BUC_POSITION_TYPE_R,        2, BALLOON_FRAME_TYPE_BUC,            "I see. I'd heard she left on a journey and such,<CR>so I thought I'd check, since she usually<CR>isn't around all that much" },
