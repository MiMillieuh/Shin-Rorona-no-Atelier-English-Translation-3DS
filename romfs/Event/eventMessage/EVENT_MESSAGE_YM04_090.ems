	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KANA,    BUC_POSITION_TYPE_L2,       3, BALLOON_FRAME_TYPE_BUC,            "What is all this noise? And if you're going to drop by,<CR>you could at least put on a less gloomy face.<CR>Today is not a good day" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_ODO,      BUC_POSITION_TYPE_R,        4, BALLOON_FRAME_TYPE_BUC,            "Now, I thought I'd hear something like that. You never change, do you?<CR>...I came because I finished the investigation<CR>you asked me to do" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_L2,       5, BALLOON_FRAME_TYPE_BUC,            "Oh? Did I ask you to do something for me,<CR>I wonder?" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KANA,     BUC_POSITION_TYPE_R,        6, BALLOON_FRAME_TYPE_BUC,            "To be precise, it wasn't me but the castle.<CR>About the survey of the area around Orthogalaxen" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "Based on the surrounding terrain, there should be<CR>ruins that are still buried and hidden...<CR>You remember, don't you?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_ODO,     BUC_POSITION_TYPE_L2,       8, BALLOON_FRAME_TYPE_BUC,            "Ah, that. Yes, I did ask the castle to look into it. How did it go?" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,        9, BALLOON_FRAME_TYPE_BUC,            "An unexplored section of the ruins was found. It's not very big,<CR>but it appears to be untouched since the time<CR>it was built" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KOMA,     BUC_POSITION_TYPE_R,       10, BALLOON_FRAME_TYPE_BUC,            "Whether it's part of Orthogalaxen or something else,<CR>I don't know, but apparently<CR>it's ruins from the same era" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_L2,      11, BALLOON_FRAME_TYPE_BUC,            "Oh? That's quite interesting" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       12, BALLOON_FRAME_TYPE_BUC,            "We've gotten permission to explore, so you can go freely.<CR>However, the ruins are quite old, so please be careful<CR>of collapses and such. And besides..." },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KOMA,     BUC_POSITION_TYPE_R,       13, BALLOON_FRAME_TYPE_BUC,            "...According to the advance party, it seems like<CR>a dragon-like creature has been spotted" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_NOR,      BUC_POSITION_TYPE_R,       14, BALLOON_FRAME_TYPE_BUC,            "Personally, I wouldn't want to just waltz in there,<CR>but I'll leave it up to the individual to decide.<CR>Well then, excuse me" },
