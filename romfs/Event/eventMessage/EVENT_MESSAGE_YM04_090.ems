	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_AKI,     BUC_POSITION_TYPE_L,       16, BALLOON_FRAME_TYPE_BUC,            "Yes yes. You want me to go in your place, right?" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_WARA,    BUC_POSITION_TYPE_R,       17, BALLOON_FRAME_TYPE_BUC,            "As expected of my disciple. You're so quick on the uptake,<CR>I almost want to hug you" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,       18, BALLOON_FRAME_TYPE_BUC,            "This has happened before, though..." },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_HOHO,    BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "You said there were unexplored areas, right? That means<CR>there's a high possibility that completely unknown<CR>materials are buried there. I'm counting on you" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX1,     BUC_POSITION_TYPE_L,       20, BALLOON_FRAME_TYPE_BUC,            "But there are dragons there, you know..." },
