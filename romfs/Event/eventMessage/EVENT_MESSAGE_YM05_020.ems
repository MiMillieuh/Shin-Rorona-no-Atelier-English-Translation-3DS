	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_WARA,   BUC_POSITION_TYPE_R,       14, BALLOON_FRAME_TYPE_BUC,            "It doesn't have to be right now.<CR>It's more important to come up with a reliable solution.<CR>I'm counting on you" },
