	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,        4, BALLOON_FRAME_TYPE_BUC,            "...There's an adventurer woman who's been<CR>going a little overboard lately. She's from a small<CR>village to the south of here" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,        5, BALLOON_FRAME_TYPE_BUC,            "It's fine that she defeats monsters for us,<CR>but she sometimes goes too far and ends up<CR>destroying ruins and buildings, making a mess of things,<CR>I wonder?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,        6, BALLOON_FRAME_TYPE_BUC,            "Have you talked to her and asked her to stop?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_AKI,    BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "If that would solve the problem, no one would be worried.<CR>The thing is, she's not doing it<CR>because she's trying to be mean or anything" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_AKI,    BUC_POSITION_TYPE_R,        8, BALLOON_FRAME_TYPE_BUC,            "So we have no choice but to try<CR>and set up some kind of monitoring system,<CR>but we just can't figure out how" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_NOR,     BUC_POSITION_TYPE_L,        9, BALLOON_FRAME_TYPE_BUC,            "I understand the situation, but...<CR>Why does this have to be your problem, Kuu-chan?" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_SIN,    BUC_POSITION_TYPE_R,       10, BALLOON_FRAME_TYPE_BUC,            "Right? Why do I have to deal with stuff like this?<CR>Requests like this have been piling up lately<CR>and it's really getting on my nerves" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_EX2,     BUC_POSITION_TYPE_L,       11, BALLOON_FRAME_TYPE_BUC,            "I see, it sounds tough" },
	{ BALLOON_MODE_BUC,    CHARA_CUDERIA,    0, NAME_CUDERIA,     BUC_CUDERIA_NOR,    BUC_POSITION_TYPE_R,       12, BALLOON_FRAME_TYPE_BUC,            "Don't just say that like it's someone else's problem!<CR>Since I told you about it, you're going to<CR>think of a good solution too, you know" },
