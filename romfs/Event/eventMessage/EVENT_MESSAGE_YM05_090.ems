	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_KANA,       BUC_POSITION_TYPE_R,        5, BALLOON_FRAME_TYPE_BUC,            "That's a rather blunt way to put it,<CR>I must say" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_L,        6, BALLOON_FRAME_TYPE_BUC,            "It's the truth, isn't it?<CR>I'm not one to talk about such things anyway" },
	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_KOMA,       BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "So what are you planning to do after this,<CR>I wonder?<CR>Does it worry you at all?" },
