	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_HOHO,       BUC_POSITION_TYPE_R,        9, BALLOON_FRAME_TYPE_BUC,            "Yes.<CR>She said everyone was so capable,<CR>so she wasn't worried at all" },
	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_IKA,     BUC_POSITION_TYPE_L,       10, BALLOON_FRAME_TYPE_BUC,            "Then there's no problem at all, is there?<CR>You didn't need to ask me in the first place" },
