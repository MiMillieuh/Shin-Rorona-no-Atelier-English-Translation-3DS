	{ BALLOON_MODE_BUC,    CHARA_GIO,        0, NAME_GIO,         BUC_GIO_NOR,        BUC_POSITION_TYPE_R,        2, BALLOON_FRAME_TYPE_BUC,            "It took me a considerable amount of time<CR>and a great deal of deliberation, but<CR>this is the conclusion I've come to" },
