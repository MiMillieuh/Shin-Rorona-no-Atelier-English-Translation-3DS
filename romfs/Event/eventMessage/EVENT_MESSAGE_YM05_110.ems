	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_KANA,     BUC_POSITION_TYPE_R,       30, BALLOON_FRAME_TYPE_BUC,            "......" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_HOHO,     BUC_POSITION_TYPE_R,       31, BALLOON_FRAME_TYPE_BUC,            "From a knight who only protects the king,<CR>to a knight who protects everyone -<CR>Yes, this is it...!" },
	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_HOHO,     BUC_POSITION_TYPE_R,       32, BALLOON_FRAME_TYPE_BUC,            "...Thanks to you,<CR>a light has begun to shine through. My thanks" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_WARA,    BUC_POSITION_TYPE_L,       33, BALLOON_FRAME_TYPE_BUC,            "No, I just had a conversation with you... and that's about it, ehehe" },
