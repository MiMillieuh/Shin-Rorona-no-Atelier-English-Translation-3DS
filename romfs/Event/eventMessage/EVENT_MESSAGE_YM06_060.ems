	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_NOR,    BUC_POSITION_TYPE_R,       19, BALLOON_FRAME_TYPE_BUC,            "Unn... After talking with you, Rorona-chan,<CR>I gradually started to gain some confidence<CR>in myself..." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_NOR,    BUC_POSITION_TYPE_R,       20, BALLOON_FRAME_TYPE_BUC,            "There are so many different people here,<CR>and everyone's enjoying themselves...<CR>Seeing that made me want to try too." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_SIN,    BUC_POSITION_TYPE_R,       21, BALLOON_FRAME_TYPE_BUC,            "I want more people to see our plays.<CR>And I want to see the smiles on<CR>everyone's faces when they watch." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_SIN,    BUC_POSITION_TYPE_R,       22, BALLOON_FRAME_TYPE_BUC,            "But to do that, I'm still not good enough yet...<CR>I need to get better." },
	{ BALLOON_MODE_BUC,    CHARA_HORO,       0, NAME_HORO,        BUC_HORO_NOR,       BUC_POSITION_TYPE_L2,      23, BALLOON_FRAME_TYPE_BUC,            "Is that so?<CR>I'd have thought you'd want to stay<CR>right where you are." },
	{ BALLOON_MODE_BUC,    CHARA_RANYA,      0, NAME_RANYA,       BUC_RANYA_NOR,      BUC_POSITION_TYPE_R2,      24, BALLOON_FRAME_TYPE_BUC,            "Right? Didn't want to leave Rorona-chan?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KANA,    BUC_POSITION_TYPE_L,       25, BALLOON_FRAME_TYPE_BUC,            "I want to be with Rio-chan too." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_SIN,    BUC_POSITION_TYPE_R,       26, BALLOON_FRAME_TYPE_BUC,            "I feel the same way...<CR>So, would you like to go together?" },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       27, BALLOON_FRAME_TYPE_BUC,            "Eh?" },
	{ BALLOON_MODE_BUC,    CHARA_HORO,       0, NAME_HORO,        BUC_HORO_NOR,       BUC_POSITION_TYPE_L2,      28, BALLOON_FRAME_TYPE_BUC,            "...Is that how it is?" },
