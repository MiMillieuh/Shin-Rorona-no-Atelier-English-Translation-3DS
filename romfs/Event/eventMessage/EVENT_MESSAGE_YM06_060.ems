	{ BALLOON_MODE_BUC,    CHARA_HORO,       0, NAME_HORO,        BUC_HORO_NOR,       BUC_POSITION_TYPE_L2,       8, BALLOON_FRAME_TYPE_BUC,            "I totally expected this from you." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_KOMA,    BUC_POSITION_TYPE_L,        9, BALLOON_FRAME_TYPE_BUC,            "Umm... I don't understand what you're saying." },
	{ BALLOON_MODE_BUC,    CHARA_HORO,       0, NAME_HORO,        BUC_HORO_NOR,       BUC_POSITION_TYPE_L2,      10, BALLOON_FRAME_TYPE_BUC,            "What I mean is, it's about time we<CR>move on to the next town." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_ODO,     BUC_POSITION_TYPE_L,       11, BALLOON_FRAME_TYPE_BUC,            "Ehー! I never heard anything about that!<CR>When? I'm not prepared at all!" },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_KANA,   BUC_POSITION_TYPE_R,       12, BALLOON_FRAME_TYPE_BUC,            "I-it's not happening immediately, but...<CR>hopefully we can go around next year or so?" },
	{ BALLOON_MODE_BUC,    CHARA_RANYA,      0, NAME_RANYA,       BUC_RANYA_NOR,      BUC_POSITION_TYPE_R2,      13, BALLOON_FRAME_TYPE_BUC,            "You need money to travel, after all.<CR>We can't leave until we've<CR>saved up enough funds either way." },
	{ BALLOON_MODE_BUC,    CHARA_RORONA,     0, NAME_RORONA,      BUC_RORONA_SIN,     BUC_POSITION_TYPE_L,       14, BALLOON_FRAME_TYPE_BUC,            "Aah, so it's not happening anytime soon.<CR>But... you'll be leaving, won't you..." },
	{ BALLOON_MODE_BUC,    CHARA_LIONELA,    0, NAME_LIONELA,     BUC_LIONELA_KANA,   BUC_POSITION_TYPE_R,       15, BALLOON_FRAME_TYPE_BUC,            "Unn..." },
	{ BALLOON_MODE_BUC,    CHARA_RANYA,      0, NAME_RANYA,       BUC_RANYA_NOR,      BUC_POSITION_TYPE_R2,      16, BALLOON_FRAME_TYPE_BUC,            "We've traveled many times before,<CR>so traveling itself isn't anything unusual,<CR>but this time is a bit different." },
	{ BALLOON_MODE_BUC,    CHARA_RANYA,      0, NAME_RANYA,       BUC_RANYA_NOR,      BUC_POSITION_TYPE_R2,      17, BALLOON_FRAME_TYPE_BUC,            "Usually, we'd have to leave because<CR>we couldn't stay in town anymore...<CR>but this time—" },
