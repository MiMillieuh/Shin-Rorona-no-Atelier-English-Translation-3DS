	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_KOMA,    BUC_POSITION_TYPE_R,        7, BALLOON_FRAME_TYPE_BUC,            "...That's it?" },
	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_EX4,     BUC_POSITION_TYPE_L2,       8, BALLOON_FRAME_TYPE_BUC,            "Yes, that's all." },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_KAN,     BUC_POSITION_TYPE_R,        9, BALLOON_FRAME_TYPE_BUC,            "A year, huh. Really?<CR>The future's still far away..." },
	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_WARA,    BUC_POSITION_TYPE_L2,      10, BALLOON_FRAME_TYPE_BUC,            "But I was thinking, even if it takes time to make,<CR>if we jump back the same amount of time,<CR>wouldn't we arrive at the same moment?" },
