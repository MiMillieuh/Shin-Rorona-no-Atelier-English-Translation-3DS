	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_IKA,     BUC_POSITION_TYPE_L2,       0, BALLOON_FRAME_TYPE_BUC,            "Totori-sensei! Rorona-san!<CR>Another capsule arrived!<CR>There's a letter inside!" },
	{ BALLOON_MODE_BUC,    CHARA_TOTORI,     0, NAME_TOTORI,      BUC_TOTORI_NOR,     BUC_POSITION_TYPE_R,        1, BALLOON_FRAME_TYPE_BUC,            "A capsule? What does Astrid-san say this time?" },
	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_NOR,     BUC_POSITION_TYPE_L2,       2, BALLOON_FRAME_TYPE_BUC,            "I'll read it! Let me see..." },
	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_KAN,     BUC_POSITION_TYPE_L2,       3, BALLOON_FRAME_TYPE_BUC,            "'We are trying to create an item to bring you back,<CR> but we still need rare materials<CR> and haven't finished yet...'" },
