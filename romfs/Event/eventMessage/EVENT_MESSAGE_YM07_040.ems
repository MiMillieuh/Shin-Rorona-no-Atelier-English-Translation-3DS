	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_WARA,    BUC_POSITION_TYPE_R,       22, BALLOON_FRAME_TYPE_BUC,            "Now then, if that's settled—time for the show!<CR>Hurry up and get changed.<CR>I could even watch you change right here!" },
