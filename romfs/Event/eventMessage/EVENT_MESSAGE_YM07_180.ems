	{ BALLOON_MODE_BUC,    CHARA_MERURU,     0, NAME_MERURU,      BUC_MERURU_NOR,     BUC_POSITION_TYPE_R,       28, BALLOON_FRAME_TYPE_BUC,            "Ah!!" },
