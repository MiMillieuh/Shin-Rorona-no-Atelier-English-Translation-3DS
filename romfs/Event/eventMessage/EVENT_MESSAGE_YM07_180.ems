	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_NOR,     BUC_POSITION_TYPE_R,       30, BALLOON_FRAME_TYPE_BUC,            "My, how impatient of them. To go ahead and leave me behind." },
