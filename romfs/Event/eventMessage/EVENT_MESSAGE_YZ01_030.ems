	{ BALLOON_MODE_BUC,    CHARA_STERK,      0, NAME_STERK,       BUC_STERK_AKI,      BUC_POSITION_TYPE_R,       48, BALLOON_FRAME_TYPE_BUC,            "Hmm... It might be that you don't understand what I'm trying to say." },
