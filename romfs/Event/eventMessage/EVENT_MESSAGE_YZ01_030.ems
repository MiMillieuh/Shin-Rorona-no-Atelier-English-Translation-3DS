	{ BALLOON_MODE_BUC,    CHARA_ASTRID,     0, NAME_ASTRID,      BUC_ASTRID_KOMA,    BUC_POSITION_TYPE_L,       11, BALLOON_FRAME_TYPE_BUC,            "If you keep acting like that, I'll have to put you in your place.<CR>Perhaps I should scold them and make them work harder?" },
